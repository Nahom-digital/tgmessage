# tgmessage configuration
# Edited by `tgmessage --token ...` / `--allow ...`, safe to edit by hand.

# BotFather token, looks like 123456789:AA........
TG_BOT_TOKEN=

# comma-separated chat ids allowed to use this bot (managed by --allow/--deny)
TG_ALLOWED_CHAT_IDS=

# chat id used by one-shot sends and opened by default in the UI
TG_DEFAULT_CHAT=

# daemon bind address
TG_HOST=127.0.0.1

# daemon port
TG_PORT=8765

# how many messages of backlog to keep per chat
TG_HISTORY=300

# getUpdates long-poll seconds
TG_POLL_TIMEOUT=30

# where files/photos sent to the bot are saved (default: <home>/files)
# TG_FILES_DIR=/root/tgmessage/files

# watcher log shown by the /logs chat command
# (default: <home>/watcher/logs/watcher.log)
# TG_WATCHER_LOG=/root/tgmessage/watcher/logs/watcher.log
